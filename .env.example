# Copy to .env and fill in. Never commit .env.

# PostgreSQL on Neon — filled by `neon init` / `neon env pull`.
# DATABASE_URL = pooled (app traffic), DATABASE_URL_UNPOOLED = direct (Prisma Migrate).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# Session signing secret — at least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Anthropic API key — server-side only. If missing/invalid, the app still works:
# tickets get keyword-based labels and admins get a reply template instead of an AI draft.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-haiku-5-5"

# "Today" for royalty reasoning. The sample dataset is a snapshot (latest payout 2025-12-01),
# so the demo reasons about it as of this date. Leave empty in production to use the real date.
REFERENCE_DATE="2026-01-15"

# Optional seed passwords
SEED_AUTHOR_PASSWORD="author123"
SEED_ADMIN_PASSWORD="admin123"
